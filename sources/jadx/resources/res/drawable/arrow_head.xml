<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape>
            <solid android:color="@android:color/transparent"/>
            <size
                android:height="70dp"
                android:width="40dp"/>
        </shape>
    </item>
    <item>
        <rotate
            android:fromDegrees="45"
            android:toDegrees="45"
            android:pivotX="94%"
            android:pivotY="50%">
            <shape
                android:shape="line"
                android:top="1dp">
                <solid android:color="@android:color/black"/>
                <stroke
                    android:width="2dp"
                    android:color="@android:color/black"/>
            </shape>
        </rotate>
    </item>
    <item>
        <rotate
            android:fromDegrees="-45"
            android:toDegrees="45"
            android:pivotX="94%"
            android:pivotY="50%">
            <shape
                android:shape="line"
                android:top="1dp">
                <solid android:color="@android:color/black"/>
                <stroke
                    android:width="2dp"
                    android:color="@android:color/black"/>
            </shape>
        </rotate>
    </item>
</layer-list>
