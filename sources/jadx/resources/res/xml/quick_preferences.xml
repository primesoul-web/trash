<?xml version="1.0" encoding="utf-8"?>
<androidx.preference.PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:title="@string/settings">
    <androidx.preference.PreferenceCategory
        android:title="@string/rendering_options"
        android:key="pref_key_rendering_options"
        app:iconSpaceReserved="false">
        <androidx.preference.ListPreference
            android:persistent="false"
            android:entries="@array/seamPrefs"
            android:title="@string/seam_settings"
            android:key="pref_key_seam_mode"
            android:summary="@string/voronoi_seam_summary"
            android:defaultValue="1"
            android:entryValues="@array/seamPrefsValues"/>
        <androidx.preference.SwitchPreference
            android:persistent="false"
            android:title="@string/blending_settings"
            android:key="pref_key_blend_state"
            android:summary="@string/blend_summary"
            android:defaultValue="true"/>
        <androidx.preference.ListPreference
            android:persistent="false"
            android:entries="@array/projectionPrefs"
            android:title="@string/projection_settings"
            android:key="pref_key_projection_surface"
            android:summary="@string/spherical_proj_summary"
            android:defaultValue="0"
            android:entryValues="@array/projectionPrefsValues"/>
        <androidx.preference.SwitchPreference
            android:persistent="false"
            android:title="@string/orientation_settings"
            android:key="pref_key_autostraighten"
            android:summary="@string/autostraighten_summary"
            android:defaultValue="true"/>
        <androidx.preference.SwitchPreference
            android:persistent="false"
            android:title="@string/cropping_settings"
            android:key="pref_key_auto_crop"
            android:summary="@string/cropping_summary"
            android:defaultValue="true"/>
        <androidx.preference.SwitchPreference
            android:persistent="false"
            android:title="@string/auto_exposure_settings"
            android:key="pref_key_auto_exposure"
            android:summary="@string/auto_exposure_summary"
            android:defaultValue="true"/>
    </androidx.preference.PreferenceCategory>
    <androidx.preference.PreferenceCategory
        android:title="@string/output_options"
        android:key="pref_key_output_options"
        app:iconSpaceReserved="false">
        <androidx.preference.SeekBarPreference
            android:persistent="false"
            android:max="100"
            android:title="@string/output_settings"
            android:key="seek_bar_key"
            android:defaultValue="100"
            app:min="1"
            app:showSeekBarValue="true"/>
        <androidx.preference.EditTextPreference
            android:persistent="false"
            android:title="@string/output_album"
            android:key="outputAlbumPreferences"
            android:defaultValue="@string/default_directory"/>
    </androidx.preference.PreferenceCategory>
</androidx.preference.PreferenceScreen>
