<?xml version="1.0" encoding="utf-8"?>
<androidx.preference.PreferenceScreen android:title="@string/settings"
  xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto">
    <androidx.preference.PreferenceCategory android:title="@string/rendering_options" android:key="pref_key_rendering_options" app:iconSpaceReserved="false">
        <androidx.preference.ListPreference android:entries="@array/seamPrefs" android:title="@string/seam_settings" android:key="pref_key_seam_mode" android:summary="@string/voronoi_seam_summary" android:defaultValue="1" android:entryValues="@array/seamPrefsValues" />
        <androidx.preference.SwitchPreference android:title="@string/blending_settings" android:key="pref_key_blend_state" android:summary="@string/blend_summary" android:defaultValue="true" />
        <androidx.preference.ListPreference android:entries="@array/projectionPrefs" android:title="@string/projection_settings" android:key="pref_key_projection_surface" android:summary="@string/spherical_proj_summary" android:defaultValue="0" android:entryValues="@array/projectionPrefsValues" />
        <androidx.preference.SwitchPreference android:title="@string/orientation_settings" android:key="pref_key_autostraighten" android:summary="@string/autostraighten_summary" android:defaultValue="true" />
        <androidx.preference.SwitchPreference android:title="@string/cropping_settings" android:key="pref_key_auto_crop" android:summary="@string/cropping_summary" android:defaultValue="true" />
        <androidx.preference.SwitchPreference android:title="@string/auto_exposure_settings" android:key="pref_key_auto_exposure" android:summary="@string/auto_exposure_summary" android:defaultValue="true" />
    </androidx.preference.PreferenceCategory>
    <androidx.preference.PreferenceCategory android:title="@string/output_options" android:key="pref_key_output_options" app:iconSpaceReserved="false">
        <androidx.preference.SeekBarPreference android:max="100" android:title="@string/output_settings" android:key="seek_bar_key" android:defaultValue="100" app:min="1" app:showSeekBarValue="true" />
        <androidx.preference.EditTextPreference android:title="@string/output_album" android:key="outputAlbumPreferences" android:defaultValue="@string/default_directory" />
    </androidx.preference.PreferenceCategory>
    <androidx.preference.PreferenceCategory android:title="@string/notification_options" android:key="pref_key_notification_options" app:iconSpaceReserved="false">
        <androidx.preference.SwitchPreference android:title="@string/notification_settings" android:key="pref_key_notification_settings" android:summary="@string/notification_summary" android:defaultValue="true" />
    </androidx.preference.PreferenceCategory>
    <androidx.preference.PreferenceCategory android:title="@string/preview_options" android:key="pref_key_preview_options" app:iconSpaceReserved="false">
        <androidx.preference.SwitchPreference android:title="@string/preview_settings" android:key="pref_key_preview_settings" android:summary="@string/preview_summary" android:defaultValue="true" />
    </androidx.preference.PreferenceCategory>
    <androidx.preference.PreferenceCategory android:title="@string/advanced_options" android:key="pref_key_advanced_options" app:iconSpaceReserved="false">
        <androidx.preference.SwitchPreference android:title="@string/auto_delete_settings" android:key="pref_key_auto_delete_settings" android:summary="@string/auto_delete_summary" android:defaultValue="false" />
    </androidx.preference.PreferenceCategory>
</androidx.preference.PreferenceScreen>
